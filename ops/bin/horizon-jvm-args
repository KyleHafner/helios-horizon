#!/usr/bin/env python3
"""Fixed-path root-only managed Sunlit JVM argfile operator boundary."""
from __future__ import annotations

import json
import hashlib
import os
import sys
from pathlib import Path

sys.path.insert(0, "/opt/game-control/src")
from game_control.managed_tuning import (  # noqa: E402
    activate_managed_argfile,
    rollback_managed_argfile,
    verify_managed_argfile,
    load_accepted_campaign,
    ManagedJvmArgfile,
)

TARGET = Path("/etc/game-control/jvm/minecraft-sunlit-cobblemon.active.args")
MANIFEST = TARGET.with_suffix(TARGET.suffix + ".manifest.json")
ROLLBACK = Path("/etc/game-control/jvm/minecraft-sunlit-cobblemon.rollback.args")
CAMPAIGN = Path("/var/lib/game-control/phase3/latest-summary.json")
BENCHMARK_DB = Path("/var/lib/game-control/state.db")
CANDIDATE = Path("/var/lib/game-control/phase3/candidate.args")
ACCEPTED_DIGEST = Path("/var/lib/game-control/phase3/accepted.digest")
ARTIFACT_ROOT = Path("/srv/game-servers/minecraft-sunlit-benchmark/.horizon-reports")


def _trusted(path: Path, limit: int) -> bool:
    try:
        info = path.lstat()
        return info.st_uid == 0 and info.st_nlink == 1 and info.st_mode & 0o022 == 0 and info.st_size <= limit and path.is_file() and not path.is_symlink()
    except OSError:
        return False


def main(argv: list[str] | None = None) -> int:
    if os.geteuid() != 0 or (argv or sys.argv[1:]) not in (["verify"], ["activate"], ["rollback"]):
        return 2
    command = (argv or sys.argv[1:])[0]
    if command == "verify":
        try:
            if not TARGET.is_file() or not MANIFEST.is_file() or MANIFEST.stat().st_size > 2048: return 1
            evidence = json.loads(MANIFEST.read_text())
            record = ManagedJvmArgfile(TARGET, evidence["argfileSha256"], evidence["campaignSha256"], MANIFEST)
            return 0 if verify_managed_argfile(record) else 1
        except (OSError, ValueError, TypeError, KeyError, json.JSONDecodeError):
            return 1
    if command == "rollback":
        rollback_managed_argfile(TARGET, ROLLBACK if ROLLBACK.exists() else None)
        return 0
    if not _trusted(CAMPAIGN, 2 * 1024 * 1024) or not _trusted(CANDIDATE, 4096) or not _trusted(ACCEPTED_DIGEST, 128): return 1
    digest = ACCEPTED_DIGEST.read_text().strip()
    if len(digest) != 64: return 1
    try:
        summary = json.loads(CAMPAIGN.read_text())
        campaign, trusted_digest = load_accepted_campaign(
            BENCHMARK_DB, profile_id="minecraft-sunlit-cobblemon",
            baseline=str(summary.get("baselinePreset", "")),
            candidate=str(summary.get("candidatePreset", "")),
            artifact_digest=digest, artifact_root=ARTIFACT_ROOT,
        )
    except Exception:
        return 1
    campaign_digest = hashlib.sha256(json.dumps(campaign, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
    if trusted_digest != campaign_digest: return 1
    args = CANDIDATE.read_text().splitlines()
    try:
        activate_managed_argfile(
            TARGET, args, campaign=campaign,
            expected_campaign_digest=campaign_digest, rollback_path=ROLLBACK,
        )
    except Exception:
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
