#!/usr/bin/env python3
"""Send a bounded Terraria console command through a fixed FIFO."""
from __future__ import annotations

import errno
import os
import pwd
import stat
import sys
from pathlib import Path
from types import MappingProxyType


DEFAULT_CONSOLE_DIR = Path("/run/game-slot")
PROFILES = frozenset(
    {"pz-rising", "terraria-vanilla", "terraria-tmod", "terraria-tmod-145-candidate"}
)
PROFILE_SERVICE_USERS = MappingProxyType(
    {
        "terraria-vanilla": "terraria-vanilla",
        "terraria-tmod": "tmodloader",
        "terraria-tmod-145-candidate": "tmodloader",
        "pz-rising": "pzuser",
    }
)
MAX_COMMAND_CHARS = 512
MAX_COMMAND_BYTES = 4096


class _NoConsole(Exception):
    """The managed process has no usable console."""


def _console_dir() -> tuple[Path, bool]:
    value = os.environ.get("GAME_CONSOLE_COMMAND_DIR")
    if value is None:
        return DEFAULT_CONSOLE_DIR, False
    if os.geteuid() != 0 or os.environ.get("GAME_CONSOLE_COMMAND_TEST_MODE") != "1":
        raise ValueError("console directory override requires root test mode")
    return Path(value), True


def _service_uid(profile: str) -> int:
    try:
        uid = pwd.getpwnam(PROFILE_SERVICE_USERS[profile]).pw_uid
    except (AttributeError, KeyError, TypeError, ValueError) as exc:
        raise ValueError("invalid console fifo") from exc
    if not isinstance(uid, int) or uid < 0:
        raise ValueError("invalid console fifo")
    return uid


def _open_fifo(path: Path, expected_uid: int) -> int:
    try:
        info = path.lstat()
    except FileNotFoundError as exc:
        raise _NoConsole from exc
    if (
        not stat.S_ISFIFO(info.st_mode)
        or info.st_uid != expected_uid
        or stat.S_IMODE(info.st_mode) != 0o600
        or info.st_nlink != 1
    ):
        raise ValueError("invalid console fifo")
    try:
        fd = os.open(path, os.O_WRONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
    except FileNotFoundError as exc:
        raise _NoConsole from exc
    except OSError as exc:
        if exc.errno == errno.ENXIO:
            raise _NoConsole from exc
        raise
    try:
        info = os.fstat(fd)
        if (
            not stat.S_ISFIFO(info.st_mode)
            or info.st_uid != expected_uid
            or stat.S_IMODE(info.st_mode) != 0o600
            or info.st_nlink != 1
        ):
            raise ValueError("invalid console fifo")
        return fd
    except BaseException:
        os.close(fd)
        raise


def _payload(command: str) -> bytes:
    if (
        not command
        or len(command) > MAX_COMMAND_CHARS
        or command.strip(" ") != command
        or any(ord(character) < 0x20 or ord(character) == 0x7F for character in command)
    ):
        raise ValueError("invalid console command")
    payload = command.encode("utf-8") + b"\n"
    if len(payload) > MAX_COMMAND_BYTES:
        raise ValueError("invalid console command")
    return payload


def _read_command(stream) -> str:
    try:
        raw = stream.read(MAX_COMMAND_BYTES + 1)
    except (OSError, ValueError, AttributeError) as exc:
        raise ValueError("invalid console command") from exc
    if not isinstance(raw, bytes) or len(raw) > MAX_COMMAND_BYTES:
        raise ValueError("invalid console command")
    try:
        return raw.decode("utf-8", "strict")
    except UnicodeDecodeError as exc:
        raise ValueError("invalid console command") from exc


def _write_exact(fd: int, payload: bytes) -> None:
    written = os.write(fd, payload)
    if written != len(payload):
        raise OSError(errno.EIO, "short console write")


def main(argv: list[str] | None = None, stdin=None) -> int:
    args = sys.argv[1:] if argv is None else argv
    try:
        if len(args) != 1:
            return 2
        profile = args[0]
        if profile not in PROFILES:
            return 2
        if stdin is None:
            stdin = getattr(sys.stdin, "buffer", None)
        if stdin is None:
            return 2
        command = _read_command(stdin)
        payload = _payload(command)
        console_dir, test_mode_override = _console_dir()
        expected_uid = os.geteuid() if test_mode_override else _service_uid(profile)
        fd = _open_fifo(console_dir / f"{profile}.console", expected_uid)
        try:
            _write_exact(fd, payload)
        finally:
            os.close(fd)
        return 0
    except (OSError, ValueError, _NoConsole):
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
