#!/usr/bin/env python3
"""Restore the example Sunlit immutable-library link and backend properties."""

from __future__ import annotations

import os
import stat
import sys
import tempfile
from pathlib import Path


MUTABLE_ROOT = Path("/srv/game-servers/minecraft-sunlit-cobblemon")
LINK = MUTABLE_ROOT / "libraries"
TARGET = Path("/opt/game-servers/minecraft-sunlit-cobblemon/libraries")
FIXED_PROPERTIES = {"server-ip": "127.0.0.1", "server-port": "25566"}


def _trusted_directory(path: Path, *, expected_uid: int) -> None:
    info = path.lstat()
    if (
        stat.S_ISLNK(info.st_mode)
        or not stat.S_ISDIR(info.st_mode)
        or info.st_uid != expected_uid
        or info.st_mode & 0o022
    ):
        raise ValueError("Sunlit directory contract is unsafe")


def _fix_backend_properties() -> None:
    properties = MUTABLE_ROOT / "server.properties"
    info = properties.lstat()
    if (
        stat.S_ISLNK(info.st_mode)
        or not stat.S_ISREG(info.st_mode)
        or info.st_uid != os.geteuid()
        or info.st_mode & 0o022
        or info.st_nlink != 1
    ):
        raise ValueError("Sunlit server.properties contract is unsafe")
    raw = properties.read_text(encoding="utf-8")
    if len(raw.encode("utf-8")) > 256 * 1024:
        raise ValueError("Sunlit server.properties is too large")
    lines = raw.splitlines(keepends=True)
    seen: set[str] = set()
    output: list[str] = []
    for line in lines:
        name, separator, _value = line.rstrip("\r\n").partition("=")
        if name in FIXED_PROPERTIES:
            if not separator or name in seen:
                raise ValueError("Sunlit server.properties has duplicate fixed keys")
            newline = "\n" if line.endswith("\n") else ""
            output.append(f"{name}={FIXED_PROPERTIES[name]}{newline}")
            seen.add(name)
        else:
            output.append(line)
    for name, value in FIXED_PROPERTIES.items():
        if name not in seen:
            output.append(f"{name}={value}\n")
    fd, temporary = tempfile.mkstemp(prefix=".server.properties.", dir=properties.parent)
    temporary_path = Path(temporary)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write("".join(output))
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary_path, stat.S_IMODE(info.st_mode))
        os.replace(temporary_path, properties)
    finally:
        temporary_path.unlink(missing_ok=True)


def main(argv: list[str] | None = None) -> int:
    args = sys.argv[1:] if argv is None else argv
    if args:
        return 2
    try:
        _trusted_directory(MUTABLE_ROOT, expected_uid=os.geteuid())
        _trusted_directory(TARGET, expected_uid=0)
        _fix_backend_properties()
        if LINK.is_symlink():
            return 0 if os.readlink(LINK) == str(TARGET) else 2
        if LINK.exists():
            return 2
        os.symlink(TARGET, LINK, target_is_directory=True)
        return 0
    except (OSError, ValueError):
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
