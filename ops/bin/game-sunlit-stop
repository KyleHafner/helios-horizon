#!/usr/bin/env python3
"""Perform the example Sunlit graceful-stop contract for systemd ExecStop."""

from __future__ import annotations

import json
import os
import signal
import stat
import sys
import time
from pathlib import Path


PROFILE = "minecraft-sunlit-cobblemon"
METADATA = Path("/run/game-slot/slot.json")
LATEST_LOG = Path("/srv/game-servers/minecraft-sunlit-cobblemon/logs/latest.log")
FORGE_ARGS = "@/opt/game-servers/minecraft-sunlit-cobblemon/libraries/example/unix_args.txt"
STOP_MARKERS = (b"Stopping server", b"Saving players", b"Saving worlds")
MAX_CAPTURE = 4 * 1024 * 1024
TIMEOUT_SECONDS = 115.0


def _ticks(pid: int) -> int | None:
    try:
        _, rest = Path(f"/proc/{pid}/stat").read_text(encoding="ascii").split(") ", 1)
        return int(rest.split()[19])
    except (OSError, ValueError, IndexError):
        return None


def _secure_regular(path: Path, *, expected_uid: int | None = None) -> os.stat_result:
    info = path.lstat()
    if (
        stat.S_ISLNK(info.st_mode)
        or not stat.S_ISREG(info.st_mode)
        or info.st_nlink != 1
        or info.st_mode & 0o022
        or expected_uid is not None and info.st_uid != expected_uid
    ):
        raise ValueError("fixed stop input is unsafe")
    return info


def _slot_identity(profile: str, pid: int) -> int:
    _secure_regular(METADATA, expected_uid=os.geteuid())
    raw = json.loads(METADATA.read_text(encoding="utf-8"))
    ticks = raw.get("proc_start_ticks")
    if (
        raw.get("profile_id") != profile
        or raw.get("pid") != pid
        or isinstance(ticks, bool)
        or not isinstance(ticks, int)
        or ticks < 0
        or _ticks(pid) != ticks
    ):
        raise ValueError("slot owner does not match Sunlit")
    return ticks


def _java_identity(pid: int) -> None:
    executable = Path(os.readlink(f"/proc/{pid}/exe"))
    command = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
    decoded = [item.decode("utf-8", "strict") for item in command if item]
    if executable.name != "java" or FORGE_ARGS not in decoded:
        raise ValueError("slot process is not the fixed Sunlit JVM")


def _read_since(path: Path, offset: int) -> tuple[int, bytes]:
    _secure_regular(path)
    size = path.stat().st_size
    if size < offset:
        offset = 0
    with path.open("rb", buffering=0) as stream:
        stream.seek(offset)
        data = stream.read(MAX_CAPTURE)
        return stream.tell(), data


def _read_tail(path: Path) -> bytes:
    _secure_regular(path)
    size = path.stat().st_size
    with path.open("rb", buffering=0) as stream:
        stream.seek(max(0, size - MAX_CAPTURE))
        return stream.read(MAX_CAPTURE)


def _verify_tail() -> bool:
    for _ in range(25):
        try:
            final_tail = _read_tail(LATEST_LOG)
        except OSError:
            final_tail = b""
        if all(marker in final_tail for marker in STOP_MARKERS):
            return True
        time.sleep(0.2)
    return False


def _stop(pid: int, ticks: int) -> bool:
    log_info = _secure_regular(LATEST_LOG)
    offset = log_info.st_size
    captured = bytearray()
    os.kill(pid, signal.SIGINT)
    deadline = time.monotonic() + TIMEOUT_SECONDS
    while time.monotonic() < deadline:
        current = _ticks(pid)
        try:
            offset, data = _read_since(LATEST_LOG, offset)
        except OSError:
            data = b""
        if data:
            captured.extend(data)
            if len(captured) > MAX_CAPTURE:
                del captured[:-MAX_CAPTURE]
        if current is None or current != ticks:
            if all(marker in captured for marker in STOP_MARKERS):
                return True
            return _verify_tail()
        time.sleep(0.2)
    return False


def main(argv: list[str] | None = None) -> int:
    args = sys.argv[1:] if argv is None else argv
    if args == [PROFILE, "verify"]:
        return 0 if _verify_tail() else 1
    if len(args) != 2 or args[0] != PROFILE:
        return 2
    try:
        pid = int(args[1], 10)
        if pid <= 1:
            raise ValueError("invalid pid")
        ticks = _slot_identity(PROFILE, pid)
        _java_identity(pid)
        return 0 if _stop(pid, ticks) else 1
    except (OSError, UnicodeError, ValueError, json.JSONDecodeError):
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
