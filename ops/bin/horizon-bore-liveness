#!/usr/bin/python3
"""Recover a live-but-stale Bore relay without touching the game backend."""

from __future__ import annotations

import fcntl
import json
import os
import socket
import stat
import subprocess
import sys
import tempfile
import time
from pathlib import Path


BORE_UNIT = "bore-minecraft-fenced.service"
LAZYMC_UNIT = "lazymc-minecraft.service"
ARM_MARKER = Path("/etc/game-control/arm/bore-minecraft")
STATE_DIR = Path("/run/horizon-bore-liveness")
STATE_FILE = STATE_DIR / "state.json"
LOCK_FILE = STATE_DIR / "lock"
LOCAL_HOST = "127.0.0.1"
LOCAL_PORT = 25565
CONTROL_PORT = 7835
FAILURE_THRESHOLD = 6
FAILURE_WINDOW_SECONDS = 3 * 60
COOLDOWN_SECONDS = 15 * 60
CONNECT_TIMEOUT_SECONDS = 1.0
SYSTEMCTL_QUERY_TIMEOUT_SECONDS = 2
SYSTEMCTL_RESTART_TIMEOUT_SECONDS = 10
RECOVERY_WAIT_SECONDS = 15


def _emit(action: str, reason: str, **fields: object) -> None:
    payload = {"action": action, "reason": reason, **fields}
    print(json.dumps(payload, sort_keys=True, separators=(",", ":")))


def _service_active(unit: str) -> bool:
    result = subprocess.run(
        ["/usr/bin/systemctl", "is-active", "--quiet", unit],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=SYSTEMCTL_QUERY_TIMEOUT_SECONDS,
    )
    return result.returncode == 0


def _service_main_pid(unit: str) -> int:
    result = subprocess.run(
        ["/usr/bin/systemctl", "show", "--property=MainPID", "--value", unit],
        check=True,
        capture_output=True,
        stdin=subprocess.DEVNULL,
        text=True,
        timeout=SYSTEMCTL_QUERY_TIMEOUT_SECONDS,
    )
    pid = int(result.stdout.strip())
    if pid <= 1:
        raise RuntimeError("service has no live main pid")
    return pid


def _arm_marker_state() -> str:
    try:
        value = ARM_MARKER.lstat()
    except FileNotFoundError:
        return "absent"
    return "valid" if _valid_arm_stat(value) else "invalid"


def _valid_arm_stat(value: os.stat_result) -> bool:
    return (
        stat.S_ISREG(value.st_mode)
        and value.st_uid == 0
        and value.st_gid == 0
        and stat.S_IMODE(value.st_mode) == 0o600
        and value.st_nlink == 1
    )


def _process_argv(pid: int) -> tuple[str, ...]:
    with Path(f"/proc/{pid}/cmdline").open("rb") as handle:
        raw = handle.read(8193)
    if not raw or len(raw) > 8192:
        raise RuntimeError("bore argv is absent or oversized")
    return tuple(item.decode("utf-8", "strict") for item in raw.rstrip(b"\0").split(b"\0"))


def _option(argv: tuple[str, ...], name: str) -> str:
    if argv.count(name) != 1:
        raise RuntimeError(f"bore argv has invalid {name} cardinality")
    index = argv.index(name)
    if index + 1 >= len(argv):
        raise RuntimeError(f"bore argv has no value for {name}")
    return argv[index + 1]


def _bore_target(argv: tuple[str, ...]) -> tuple[str, int]:
    if len(argv) < 4 or argv[0] != "/usr/local/bin/bore" or argv[1:3] != ("local", "25565"):
        raise RuntimeError("bore argv is outside the fixed relay contract")
    if _option(argv, "--local-host") != LOCAL_HOST:
        raise RuntimeError("bore local host is outside the fixed relay contract")
    remote = _option(argv, "--to")
    if not remote or len(remote) > 253 or any(character.isspace() for character in remote):
        raise RuntimeError("bore remote host is invalid")
    port_text = _option(argv, "--port")
    if not port_text.isascii() or not port_text.isdecimal():
        raise RuntimeError("bore remote port is invalid")
    port = int(port_text)
    if port != LOCAL_PORT:
        raise RuntimeError("bore remote port is outside the fixed relay contract")
    return remote, port


def _tcp_open(host: str, port: int) -> bool:
    try:
        with socket.create_connection((host, port), timeout=CONNECT_TIMEOUT_SECONDS):
            return True
    except OSError:
        return False


def _tcp_rows() -> tuple[dict[str, object], ...]:
    rows: list[dict[str, object]] = []
    for table_path, family in ((Path("/proc/net/tcp"), "ipv4"), (Path("/proc/net/tcp6"), "ipv6")):
        with table_path.open("rb") as handle:
            raw = handle.read(2 * 1024 * 1024 + 1)
        if len(raw) > 2 * 1024 * 1024:
            raise RuntimeError("kernel tcp table is oversized")
        for line in raw.decode("ascii", "strict").splitlines()[1:]:
            fields = line.split()
            if len(fields) < 10:
                raise RuntimeError("kernel tcp row is malformed")
            local_address, local_port = fields[1].split(":", 1)
            _remote_address, remote_port = fields[2].split(":", 1)
            rows.append(
                {
                    "family": family,
                    "local_address": local_address,
                    "local_port": int(local_port, 16),
                    "remote_port": int(remote_port, 16),
                    "state": fields[3],
                    "inode": int(fields[9]),
                }
            )
    return tuple(rows)


def _pid_socket_inodes(pid: int) -> frozenset[int]:
    inodes: set[int] = set()
    descriptors = tuple(Path(f"/proc/{pid}/fd").iterdir())
    if len(descriptors) > 4096:
        raise RuntimeError("service fd set is oversized")
    for descriptor in descriptors:
        try:
            target = os.readlink(descriptor)
        except FileNotFoundError:
            continue
        if target.startswith("socket:[") and target.endswith("]"):
            inode_text = target[8:-1]
            if inode_text.isdecimal():
                inodes.add(int(inode_text))
    return frozenset(inodes)


def _local_listener_owned(lazymc_pid: int) -> bool:
    listeners = tuple(
        row
        for row in _tcp_rows()
        if row["local_port"] == LOCAL_PORT and row["state"] == "0A"
    )
    return (
        len(listeners) == 1
        and listeners[0]["family"] == "ipv4"
        and listeners[0]["local_address"] == "00000000"
        and listeners[0]["inode"] in _pid_socket_inodes(lazymc_pid)
    )


def _bore_control_owned(bore_pid: int) -> bool:
    owned = _pid_socket_inodes(bore_pid)
    return any(
        row["state"] == "01"
        and row["remote_port"] == CONTROL_PORT
        and row["inode"] in owned
        for row in _tcp_rows()
    )


def _local_client_sessions_present() -> bool:
    return any(
        row["state"] == "01" and row["local_port"] == LOCAL_PORT
        for row in _tcp_rows()
    )


def _load_state() -> dict[str, int]:
    try:
        descriptor = os.open(STATE_FILE, os.O_RDONLY | os.O_NOFOLLOW)
        try:
            if not _valid_state_stat(os.fstat(descriptor)):
                raise RuntimeError("liveness state metadata is invalid")
            raw = os.read(descriptor, 1025)
        finally:
            os.close(descriptor)
        if len(raw) > 1024:
            raise ValueError("oversized state")
        payload = json.loads(raw)
        failures = payload.get("failures", 0)
        first_failure = payload.get("first_failure", 0)
        last_restart = payload.get("last_restart", 0)
        if type(failures) is not int or failures < 0:
            raise ValueError("invalid failure count")
        if type(first_failure) is not int or first_failure < 0:
            raise ValueError("invalid first failure timestamp")
        if type(last_restart) is not int or last_restart < 0:
            raise ValueError("invalid restart timestamp")
        return {
            "failures": failures,
            "first_failure": first_failure,
            "last_restart": last_restart,
        }
    except FileNotFoundError:
        return {"failures": 0, "first_failure": 0, "last_restart": 0}
    except (OSError, ValueError, json.JSONDecodeError, AttributeError):
        raise RuntimeError("liveness state is invalid")


def _valid_state_stat(value: os.stat_result) -> bool:
    return (
        stat.S_ISREG(value.st_mode)
        and value.st_uid == 0
        and value.st_gid == 0
        and stat.S_IMODE(value.st_mode) == 0o600
        and value.st_nlink == 1
    )


def _write_all(descriptor: int, payload: bytes) -> None:
    remaining = memoryview(payload)
    while remaining:
        written = os.write(descriptor, remaining)
        if written <= 0:
            raise OSError("short state write")
        remaining = remaining[written:]


def _sync_descriptor(descriptor: int) -> None:
    os.fsync(descriptor)


def _save_state(state_value: dict[str, int]) -> None:
    STATE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor, temporary_text = tempfile.mkstemp(prefix=".state.", dir=STATE_DIR)
    temporary = Path(temporary_text)
    try:
        os.fchmod(descriptor, 0o600)
        payload = json.dumps(state_value, sort_keys=True, separators=(",", ":")).encode()
        _write_all(descriptor, payload)
        _sync_descriptor(descriptor)
        os.close(descriptor)
        descriptor = -1
        os.replace(temporary, STATE_FILE)
        directory_descriptor = os.open(STATE_DIR, os.O_RDONLY | os.O_DIRECTORY)
        try:
            _sync_descriptor(directory_descriptor)
        finally:
            os.close(directory_descriptor)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def _reset_failures(state_value: dict[str, int]) -> dict[str, int]:
    return {
        "failures": 0,
        "first_failure": 0,
        "last_restart": state_value.get("last_restart", 0),
    }


def _failure_decision(state_value: dict[str, int], now: int) -> tuple[str, dict[str, int]]:
    first_failure = state_value.get("first_failure", 0) or now
    updated = {
        "failures": min(state_value.get("failures", 0) + 1, FAILURE_THRESHOLD),
        "first_failure": first_failure,
        "last_restart": state_value.get("last_restart", 0),
    }
    if updated["first_failure"] > now or updated["last_restart"] > now:
        raise RuntimeError("liveness monotonic timestamp is invalid")
    if updated["last_restart"] and now - updated["last_restart"] < COOLDOWN_SECONDS:
        return "cooldown", updated
    if (
        updated["failures"] < FAILURE_THRESHOLD
        or now - updated["first_failure"] < FAILURE_WINDOW_SECONDS
    ):
        return "observe", updated
    return "restart", updated


def _edge_gate(remote: str, public_port: int, *, public_must_be_open: bool) -> str:
    marker = _arm_marker_state()
    if marker != "valid":
        return f"arm_marker_{marker}"
    if not _service_active(BORE_UNIT):
        return "bore_inactive"
    if not _service_active(LAZYMC_UNIT):
        return "local_proxy_unhealthy"
    bore_pid = _service_main_pid(BORE_UNIT)
    lazymc_pid = _service_main_pid(LAZYMC_UNIT)
    if not _local_listener_owned(lazymc_pid) or not _tcp_open(LOCAL_HOST, LOCAL_PORT):
        return "local_proxy_unhealthy"
    if not _bore_control_owned(bore_pid):
        return "bore_control_ownership_invalid"
    if _local_client_sessions_present():
        return "local_client_sessions_present"
    current_target = _bore_target(_process_argv(bore_pid))
    if current_target != (remote, public_port):
        return "bore_target_changed"
    if not _tcp_open(remote, CONTROL_PORT):
        return "remote_control_unreachable"
    public_open = _tcp_open(remote, public_port)
    if public_must_be_open:
        return "ready" if public_open else "public_listener_missing"
    return "public_listener_recovered" if public_open else "ready"


def _restart_bore() -> None:
    subprocess.run(
        ["/usr/bin/systemctl", "restart", BORE_UNIT],
        check=True,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=SYSTEMCTL_RESTART_TIMEOUT_SECONDS,
    )


def _wait_for_recovery(remote: str, public_port: int) -> tuple[bool, str]:
    deadline = time.monotonic() + RECOVERY_WAIT_SECONDS
    while time.monotonic() < deadline:
        recovery_gate = _edge_gate(remote, public_port, public_must_be_open=True)
        if recovery_gate == "ready":
            return True, "bore_restarted"
        if recovery_gate != "public_listener_missing":
            return False, f"post_restart_{recovery_gate}"
        remaining = deadline - time.monotonic()
        if remaining > 0:
            time.sleep(min(1.0, remaining))
    return False, "restart_did_not_restore_edge"


def _check_only() -> int:
    marker = _arm_marker_state()
    if marker != "valid":
        _emit("hold" if marker == "invalid" else "skip", f"arm_marker_{marker}")
        return 2 if marker == "invalid" else 0
    if not _service_active(BORE_UNIT):
        _emit("skip", "bore_inactive")
        return 0
    if not _service_active(LAZYMC_UNIT):
        _emit("skip", "lazymc_inactive")
        return 0
    bore_pid = _service_main_pid(BORE_UNIT)
    lazymc_pid = _service_main_pid(LAZYMC_UNIT)
    remote, public_port = _bore_target(_process_argv(bore_pid))
    local_owned = _local_listener_owned(lazymc_pid)
    control_owned = _bore_control_owned(bore_pid)
    local_open = local_owned and _tcp_open(LOCAL_HOST, LOCAL_PORT)
    control_open = _tcp_open(remote, CONTROL_PORT)
    public_open = _tcp_open(remote, public_port) if control_open else False
    _emit(
        "healthy" if local_open and control_open and public_open else "observe",
        "check_only",
        local_open=local_open,
        local_owned=local_owned,
        control_owned=control_owned,
        control_open=control_open,
        public_open=public_open,
    )
    return 0 if local_open and control_owned and control_open and public_open else 1


def _run_once() -> int:
    STATE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    lock_descriptor = os.open(LOCK_FILE, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        try:
            fcntl.flock(lock_descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            _emit("skip", "check_already_running")
            return 0
        state_value = _load_state()
        marker = _arm_marker_state()
        if marker == "absent":
            _save_state(_reset_failures(state_value))
            _emit("skip", "arm_marker_absent")
            return 0
        if marker != "valid":
            _save_state(_reset_failures(state_value))
            _emit("hold", "arm_marker_invalid")
            return 2
        if not _service_active(BORE_UNIT):
            _save_state(_reset_failures(state_value))
            _emit("skip", "bore_inactive")
            return 0
        if not _service_active(LAZYMC_UNIT):
            _save_state(_reset_failures(state_value))
            _emit("skip", "local_proxy_unhealthy")
            return 0
        bore_pid = _service_main_pid(BORE_UNIT)
        lazymc_pid = _service_main_pid(LAZYMC_UNIT)
        if not _local_listener_owned(lazymc_pid) or not _tcp_open(LOCAL_HOST, LOCAL_PORT):
            _save_state(_reset_failures(state_value))
            _emit("skip", "local_proxy_unhealthy")
            return 0
        if not _bore_control_owned(bore_pid):
            _save_state(_reset_failures(state_value))
            _emit("skip", "bore_control_ownership_invalid")
            return 0
        remote, public_port = _bore_target(_process_argv(bore_pid))
        if not _tcp_open(remote, CONTROL_PORT):
            _save_state(_reset_failures(state_value))
            _emit("skip", "remote_control_unreachable")
            return 0
        if _tcp_open(remote, public_port):
            _save_state(_reset_failures(state_value))
            _emit("healthy", "public_listener_reachable")
            return 0
        if _local_client_sessions_present():
            _save_state(_reset_failures(state_value))
            _emit("skip", "local_client_sessions_present")
            return 0

        now = int(time.monotonic())
        decision, updated = _failure_decision(state_value, now)
        _save_state(updated)
        if decision == "observe":
            _emit("observe", "public_listener_missing", failures=updated["failures"])
            return 0
        if decision == "cooldown":
            remaining = COOLDOWN_SECONDS - (now - updated["last_restart"])
            _emit("skip", "restart_cooldown", failures=updated["failures"], cooldown_remaining=remaining)
            return 0

        gate = _edge_gate(remote, public_port, public_must_be_open=False)
        if gate != "ready":
            _save_state(_reset_failures(state_value))
            if gate == "arm_marker_invalid":
                _emit("hold", gate)
                return 2
            _emit("healthy" if gate == "public_listener_recovered" else "skip", gate)
            return 0

        _save_state({"failures": 0, "first_failure": 0, "last_restart": now})
        _restart_bore()
        recovered, reason = _wait_for_recovery(remote, public_port)
        _emit("recovered" if recovered else "failed", reason, failures=FAILURE_THRESHOLD)
        return 0 if recovered else 1
    finally:
        os.close(lock_descriptor)


def main(argv: list[str] | None = None) -> int:
    values = list(sys.argv[1:] if argv is None else argv)
    if values == ["--check"]:
        try:
            return _check_only()
        except (OSError, RuntimeError, subprocess.SubprocessError, ValueError):
            _emit("hold", "check_failed")
            return 2
    if values:
        _emit("hold", "unsupported_arguments")
        return 2
    try:
        return _run_once()
    except (OSError, RuntimeError, subprocess.SubprocessError, ValueError):
        _emit("hold", "liveness_check_failed")
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
