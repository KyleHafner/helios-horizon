#!/bin/sh
set -eu

SECRET_DIR=/etc/game-control/secrets.d

if [ "$(id -u)" -ne 0 ]; then
    echo "must run as root" >&2
    exit 1
fi
if [ "$#" -ne 1 ] || [ "$1" != "discord" ] && [ "$1" != "telegram" ]; then
    echo "usage: game-control-set-notification-secret <discord|telegram>" >&2
    exit 2
fi
channel=$1

umask 077
if [ -L /etc/game-control ] || [ -L "$SECRET_DIR" ]; then
    echo "secret directory is a symlink" >&2
    exit 1
fi
mkdir -p "$SECRET_DIR"
chmod 700 "$SECRET_DIR"
tmp=$(mktemp "$SECRET_DIR/.${channel}.tmp.XXXXXXXX")
trap 'rm -f "$tmp"' EXIT HUP INT TERM
chmod 600 "$tmp"

# The value is read exclusively from stdin.  It is never accepted as an
# argument, echoed, logged, or interpolated into a command.
cat >"$tmp"
[ -s "$tmp" ] || {
    echo "secret value is empty" >&2
    exit 1
}

# fsync the temporary file before the same-directory atomic rename.
python3 - "$tmp" <<'PY'
import os
import sys

with open(sys.argv[1], "rb", buffering=0) as stream:
    os.fsync(stream.fileno())
PY
chmod 600 "$tmp"
mv -f "$tmp" "$SECRET_DIR/$channel"
trap - EXIT HUP INT TERM
chmod 600 "$SECRET_DIR/$channel"
