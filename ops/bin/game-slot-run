#!/usr/bin/env python3
"""Acquire the common game slot and exec one root-configured game process."""
from __future__ import annotations

import fcntl
import hashlib
import grp
import json
import math
import os
import stat
import sys
import tempfile
import time
from pathlib import Path


DEFAULT_CONFIG_DIR = Path("/etc/game-control/runner.d")
DEFAULT_OPERATION_LOCK = Path("/run/game-control/operation.lock")
DEFAULT_SLOT_LOCK = Path("/run/game-control/slot.lock")
DEFAULT_METADATA = Path("/run/game-slot/slot.json")
DEFAULT_RESERVATION = Path("/run/game-control/reservation.json")
DEFAULT_CONSOLE_DIR = Path("/run/game-slot")
SUNLIT_PROFILE = "minecraft-sunlit-cobblemon"
SUNLIT_ACTIVE_LINK = Path("/srv/game-servers/minecraft-sunlit-cobblemon-current")
SUNLIT_RELEASE_ROOT = Path("/opt/game-servers/minecraft-sunlit-cobblemon/releases")
SUNLIT_STATE_ROOT = Path("/srv/game-servers/minecraft-sunlit-cobblemon-state")
PROFILES = frozenset(
    {
        "minecraft",
        "minecraft-sunlit-cobblemon",
        "pz-rising",
        "terraria-vanilla",
        "terraria-tmod",
        "terraria-tmod-145-candidate",
    }
)
CONSOLE_PROFILES = frozenset(
    {"pz-rising", "terraria-vanilla", "terraria-tmod", "terraria-tmod-145-candidate"}
)
MAX_TTL = 30.0
SLOT_ACQUIRE_TIMEOUT_SECONDS = 0.5
SLOT_ACQUIRE_POLL_SECONDS = 0.01


def _profile(value: str) -> str:
    if value not in PROFILES:
        raise ValueError("invalid profile id")
    return value


def _secure_regular(path: Path) -> None:
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise ValueError("runner config is not root-owned and non-writable")


def _secure_lock_fd(fd: int) -> None:
    info = os.fstat(fd)
    if os.geteuid() == 0 and os.environ.get("GAME_SLOT_RUNNER_TEST_MODE") == "1":
        if not stat.S_ISREG(info.st_mode):
            raise ValueError("lock is not a regular file")
        return
    try:
        gameslot_gid = grp.getgrnam("gameslot").gr_gid
    except KeyError as exc:
        raise ValueError("gameslot group is unavailable") from exc
    mode = stat.S_IMODE(info.st_mode)
    if (
        not stat.S_ISREG(info.st_mode)
        or info.st_uid != 0
        or info.st_gid != gameslot_gid
        or mode != 0o660
        or info.st_nlink != 1
    ):
        raise ValueError("slot lock is not root:gameslot 0660")


def _open_secure_lock(path: Path, flags: int) -> int:
    fd = os.open(path, flags | os.O_NOFOLLOW)
    try:
        _secure_lock_fd(fd)
    except BaseException:
        os.close(fd)
        raise
    return fd


def _acquire_slot(fd: int) -> bool:
    """Tolerate brief read-only inspector locks without waiting on a real owner."""

    deadline = time.monotonic() + SLOT_ACQUIRE_TIMEOUT_SECONDS
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return True
        except BlockingIOError:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return False
            time.sleep(min(SLOT_ACQUIRE_POLL_SECONDS, remaining))


def _secure_config_dir(path: Path) -> None:
    info = path.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise ValueError("runner config directory is not root-owned and non-writable")


def _config(profile: str) -> dict[str, object]:
    directory = Path(os.environ.get("GAME_SLOT_RUNNER_DIR", DEFAULT_CONFIG_DIR))
    _secure_config_dir(directory)
    path = directory / f"{profile}.json"
    _secure_regular(path)
    raw = json.loads(path.read_text())
    if not isinstance(raw, dict):
        raise ValueError("invalid runner config")
    return raw


def _managed_jvm_layer(profile: str, command: list[str]) -> list[str]:
    """Add an optional root-controlled argfile without editing modpack args."""
    if profile != "minecraft-sunlit-cobblemon" or not command or Path(command[0]).name != "java":
        return command
    path = Path("/etc/game-control/jvm/minecraft-sunlit-cobblemon.active.args")
    manifest = path.with_suffix(path.suffix + ".manifest.json")
    try:
        info = path.lstat()
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or stat.S_IMODE(info.st_mode) != 0o644 or info.st_size > 4096:
            raise ValueError("managed JVM argfile is not root-controlled")
        manifest_info = manifest.lstat()
        if not stat.S_ISREG(manifest_info.st_mode) or manifest_info.st_uid != 0 or stat.S_IMODE(manifest_info.st_mode) != 0o644 or manifest_info.st_size > 2048:
            raise ValueError("managed JVM argfile manifest is not root-controlled")
        evidence = json.loads(manifest.read_text())
        if evidence.get("schemaVersion") != 1 or evidence.get("profileId") != profile or evidence.get("overallVerdict") != "better" or not evidence.get("campaignSha256"):
            raise ValueError("managed JVM argfile manifest provenance is invalid")
        if evidence.get("campaignSha256", "") == "" or evidence.get("argfileSha256") != hashlib.sha256(path.read_bytes()).hexdigest():
            raise ValueError("managed JVM argfile hash binding is invalid")
    except FileNotFoundError:
        return command
    try:
        index = next(index for index, value in enumerate(command) if value.endswith("/unix_args.txt"))
    except StopIteration as exc:
        raise ValueError("Forge argument boundary is unavailable") from exc
    return [*command[:index], f"@{path}", *command[index:]]


def _path_override(name: str, default: Path) -> Path:
    value = os.environ.get(name)
    if value is None:
        return default
    if os.geteuid() != 0 or os.environ.get("GAME_SLOT_RUNNER_TEST_MODE") != "1":
        raise ValueError("runner path overrides require root test mode")
    return Path(value)


def _argv(value: object) -> list[str]:
    if not isinstance(value, list) or not value:
        raise ValueError("argv must be a non-empty list")
    if any(
        not isinstance(item, str)
        or not item
        or len(item) > 4096
        or "\x00" in item
        or "\n" in item
        or "\r" in item
        for item in value
    ):
        raise ValueError("argv contains an invalid value")
    if not Path(value[0]).is_absolute():
        raise ValueError("executable must be absolute")
    # The two existing deployments use a fixed script entrypoint through
    # /usr/bin/bash.  Keep shell interpolation unavailable while permitting
    # only that literal interpreter and a non-option script name.
    if Path(value[0]).name in {"sh", "bash", "dash", "zsh", "fish"}:
        if value[0] != "/usr/bin/bash" or len(value) < 2 or value[1].startswith("-"):
            raise ValueError("shell executables are not permitted")
    if any(item in {"-c", "--command", "--execute"} for item in value[1:]):
        raise ValueError("shell command options are not permitted")
    return value


def _cwd(value: object) -> str:
    if not isinstance(value, str) or not value or "\x00" in value or not Path(value).is_absolute():
        raise ValueError("cwd must be an absolute path")
    path = Path(value)
    if not path.is_dir():
        raise ValueError("cwd does not exist")
    return str(path)


def _environment(value: object) -> dict[str, str]:
    if value is None:
        return {}
    if not isinstance(value, dict):
        raise ValueError("environment must be an object")
    blocked = {"LD_PRELOAD", "LD_LIBRARY_PATH", "PYTHONPATH", "PYTHONHOME", "BASH_ENV", "ENV", "IFS"}
    result: dict[str, str] = {}
    for key, item in value.items():
        if (
            not isinstance(key, str)
            or not key
            or not key.replace("_", "A").isalnum()
            or key in blocked
            or not isinstance(item, str)
            or "\x00" in item
            or "\n" in item
        ):
            raise ValueError("environment contains an invalid value")
        result[key] = item
    return result


def _sunlit_path(name: str, default: Path) -> Path:
    """Permit path substitution only inside the existing root test boundary."""
    override = os.environ.get(name)
    if override is None:
        return default
    if os.geteuid() != 0 or os.environ.get("GAME_SLOT_RUNNER_TEST_MODE") != "1":
        raise ValueError("Sunlit path overrides require root test mode")
    return Path(override)


def _sunlit_runtime_contract(profile: str, config: dict[str, object]) -> None:
    """Bind the advertised Sunlit release to the process that will be exec'd.

    The updater publishes one root-owned active symlink.  A stale runner that
    points at the legacy mutable tree must fail before it can acquire the slot
    or launch a JVM, even if the UI already reports the newer release record.
    """
    if profile != SUNLIT_PROFILE:
        return
    active_link = _sunlit_path("GAME_SLOT_SUNLIT_ACTIVE_LINK", SUNLIT_ACTIVE_LINK)
    release_root = _sunlit_path("GAME_SLOT_SUNLIT_RELEASE_ROOT", SUNLIT_RELEASE_ROOT)
    state_root = _sunlit_path("GAME_SLOT_SUNLIT_STATE_ROOT", SUNLIT_STATE_ROOT)
    if config.get("cwd") != str(active_link) or not active_link.is_symlink():
        raise ValueError("Sunlit runner is not bound to the active release")
    active_release = active_link.resolve(strict=True)
    canonical_root = release_root.resolve(strict=True)
    if active_release.parent != canonical_root:
        raise ValueError("Sunlit active release is outside the release root")
    argv = _argv(config.get("argv"))
    required_argv = {
        f"-Duser.home={state_root / 'local'}",
        f"@{active_link / 'user_jvm_args.txt'}",
    }
    if argv[0] != "/usr/bin/java" or not required_argv.issubset(argv):
        raise ValueError("Sunlit runner arguments are not release-bound")
    environment = _environment(config.get("environment", {}))
    if environment.get("HOME") != str(state_root / "local"):
        raise ValueError("Sunlit runner home is not state-bound")
    state_info = state_root.lstat()
    horizon_info = (state_root / ".horizon").lstat()
    if (
        stat.S_ISLNK(state_info.st_mode)
        or not stat.S_ISDIR(state_info.st_mode)
        or state_info.st_mode & 0o022
        or stat.S_ISLNK(horizon_info.st_mode)
        or not stat.S_ISDIR(horizon_info.st_mode)
        or horizon_info.st_uid != state_info.st_uid
        or horizon_info.st_gid != state_info.st_gid
        or horizon_info.st_mode & 0o022
    ):
        raise ValueError("Sunlit state root is unsafe")
    release_record = state_root / ".horizon/release.json"
    info = release_record.lstat()
    if (
        not stat.S_ISREG(info.st_mode)
        or info.st_uid != state_info.st_uid
        or info.st_gid != state_info.st_gid
        or stat.S_IMODE(info.st_mode) != 0o640
        or info.st_nlink != 1
        or info.st_size > 64 * 1024
    ):
        raise ValueError("Sunlit release record is unsafe")
    record = json.loads(release_record.read_text(encoding="utf-8"))
    if not isinstance(record, dict) or record.get("version") != active_release.name:
        raise ValueError("Sunlit release record does not match the active release")


def _console_path(value: object, profile: str) -> Path | None:
    if value is None:
        return None
    if profile not in CONSOLE_PROFILES or not isinstance(value, str):
        raise ValueError("console fifo is not permitted")
    directory = DEFAULT_CONSOLE_DIR
    override = os.environ.get("GAME_SLOT_RUNNER_CONSOLE_DIR")
    if override is not None:
        if os.geteuid() != 0 or os.environ.get("GAME_SLOT_RUNNER_TEST_MODE") != "1":
            raise ValueError("console directory override requires root test mode")
        directory = Path(override)
    expected = directory / f"{profile}.console"
    if Path(value) != expected:
        raise ValueError("console fifo path is not fixed")
    return expected


def _prepare_console(path: Path) -> int:
    try:
        info = path.lstat()
    except FileNotFoundError:
        pass
    else:
        if (
            not stat.S_ISFIFO(info.st_mode)
            or info.st_uid != os.geteuid()
            or stat.S_IMODE(info.st_mode) != 0o600
            or info.st_nlink != 1
        ):
            raise ValueError("existing console fifo is unsafe")
        path.unlink()
    os.mkfifo(path, 0o600)
    fd = os.open(path, os.O_RDWR | os.O_NONBLOCK | os.O_NOFOLLOW)
    info = os.fstat(fd)
    if (
        not stat.S_ISFIFO(info.st_mode)
        or info.st_uid != os.geteuid()
        or stat.S_IMODE(info.st_mode) != 0o600
        or info.st_nlink != 1
    ):
        os.close(fd)
        raise ValueError("console fifo is unsafe")
    os.set_blocking(fd, True)
    return fd


def _ticks(pid: int) -> int | None:
    try:
        _, rest = Path(f"/proc/{pid}/stat").read_text().split(") ", 1)
        return int(rest.split()[19])
    except (OSError, ValueError, IndexError):
        return None


def _reservation_status(path: Path, profile: str) -> bool | None:
    try:
        _secure_regular(path)
    except (FileNotFoundError, ValueError):
        return None
    try:
        raw = json.loads(path.read_text())
    except (FileNotFoundError, OSError, ValueError, UnicodeDecodeError):
        return None
    if not isinstance(raw, dict):
        return None
    try:
        reserved_profile = _profile(raw["profile_id"])
        operation_id = raw["operation_id"]
        generation = raw["state_generation"]
        pid = raw["controller_pid"]
        ticks = raw["controller_start_ticks"]
        expires = raw["expires_at"]
        operation_kind = raw.get("operation_kind", "lifecycle")
        if (
            not isinstance(operation_id, str)
            or not operation_id
            or not isinstance(generation, int)
            or isinstance(generation, bool)
            or generation < 0
            or not isinstance(pid, int)
            or isinstance(pid, bool)
            or pid <= 0
            or not isinstance(ticks, int)
            or isinstance(ticks, bool)
            or ticks < 0
            or not isinstance(expires, (int, float))
            or isinstance(expires, bool)
            or operation_kind not in {"lifecycle", "update"}
        ):
            return None
        try:
            expiry = float(expires)
        except (TypeError, ValueError, OverflowError):
            return None
        if not math.isfinite(expiry):
            return None
        now = time.time()
        if not now < expiry <= now + MAX_TTL or _ticks(pid) != ticks:
            return None
    except (KeyError, TypeError, ValueError):
        return None
    # An updater reservation fences every lifecycle start, including a direct
    # systemd invocation. A matching profile alone is not authorization.
    return reserved_profile == profile and operation_kind == "lifecycle"


def _reservation_required() -> bool:
    value = os.environ.get("GAME_SLOT_REQUIRE_RESERVATION", "0")
    if value not in {"0", "1"}:
        raise ValueError("invalid reservation policy")
    return value == "1"


def _metadata(path: Path, profile: str) -> None:
    payload = {
        "pid": os.getpid(),
        "profile_id": profile,
        "proc_start_ticks": _ticks(os.getpid()),
    }
    if payload["proc_start_ticks"] is None:
        raise RuntimeError("cannot read process start time")
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(name)
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "w") as stream:
            json.dump(payload, stream, separators=(",", ":"))
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        temporary.unlink(missing_ok=True)


def main(argv: list[str] | None = None) -> int:
    args = sys.argv[1:] if argv is None else argv
    if len(args) != 1:
        return 2
    try:
        profile = _profile(args[0])
        config = _config(profile)
        _sunlit_runtime_contract(profile, config)
        command = _managed_jvm_layer(profile, _argv(config["argv"]))
        cwd = _cwd(config["cwd"])
        console = _console_path(config.get("console_fifo"), profile)
        operation = _path_override("GAME_SLOT_RUNNER_OPERATION_LOCK", DEFAULT_OPERATION_LOCK)
        slot = _path_override("GAME_SLOT_RUNNER_SLOT_LOCK", DEFAULT_SLOT_LOCK)
        metadata = _path_override("GAME_SLOT_RUNNER_METADATA", DEFAULT_METADATA)
        reservation = _path_override("GAME_SLOT_RUNNER_RESERVATION", DEFAULT_RESERVATION)
        operation_fd = _open_secure_lock(operation, os.O_RDONLY)
        fcntl.flock(operation_fd, fcntl.LOCK_SH)
        try:
            status = _reservation_status(reservation, profile)
            if status is False or (_reservation_required() and status is not True):
                return 75
            slot_fd = _open_secure_lock(slot, os.O_RDWR)
            try:
                if not _acquire_slot(slot_fd):
                    os.close(slot_fd)
                    return 75
                _metadata(metadata, profile)
                os.set_inheritable(slot_fd, True)
                fcntl.flock(operation_fd, fcntl.LOCK_UN)
                os.close(operation_fd)
                os.chdir(cwd)
                if console is not None:
                    console_fd = _prepare_console(console)
                    try:
                        os.dup2(console_fd, 0)
                    finally:
                        if console_fd != 0:
                            os.close(console_fd)
                os.execvpe(command[0], command, _environment(config.get("environment", {})))
            except BaseException:
                try:
                    os.close(slot_fd)
                except OSError:
                    pass
                raise
        finally:
            try:
                os.close(operation_fd)
            except OSError:
                pass
    except SystemExit:
        raise
    except (KeyError, TypeError, OSError, ValueError, json.JSONDecodeError):
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
