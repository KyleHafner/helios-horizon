#!/usr/bin/env python3
"""Configure Sunlit's private RCON settings from a systemd credential."""

from __future__ import annotations

import os
import stat
import sys
import tempfile
from pathlib import Path


PROPERTIES_LINK = Path("/srv/game-servers/minecraft-sunlit-cobblemon-current/server.properties")
STATE_ROOT = Path("/srv/game-servers/minecraft-sunlit-cobblemon-state")
PORT = "25575"
MAX_CREDENTIAL_BYTES = 1024
KEYS = {
    "enable-rcon": "true",
    "rcon.port": PORT,
}


def _credential() -> str:
    directory = os.environ.get("CREDENTIALS_DIRECTORY")
    if not directory:
        raise ValueError("RCON credential is unavailable")
    path = Path(directory) / "minecraft-rcon-password"
    info = path.lstat()
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
        raise ValueError("RCON credential is unavailable")
    with path.open("rb") as stream:
        raw = stream.read(MAX_CREDENTIAL_BYTES + 1)
    if len(raw) > MAX_CREDENTIAL_BYTES:
        raise ValueError("RCON credential is unavailable")
    value = raw.decode("utf-8").rstrip("\n")
    if not value or any(ord(char) < 0x20 or ord(char) == 0x7F for char in value):
        raise ValueError("RCON credential is unavailable")
    return value


def main() -> int:
    try:
        credential = _credential()
        if not PROPERTIES_LINK.is_symlink():
            raise ValueError("Sunlit properties are unavailable")
        properties = PROPERTIES_LINK.resolve(strict=True)
        try:
            properties.relative_to(STATE_ROOT)
        except ValueError as exc:
            raise ValueError("Sunlit properties are unavailable") from exc
        info = properties.lstat()
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            raise ValueError("Sunlit properties are unavailable")
        lines = properties.read_text(encoding="utf-8").splitlines(keepends=True)
        values = {**KEYS, "rcon.password": credential}
        output: list[str] = []
        found: set[str] = set()
        for line in lines:
            if "=" in line and not line.lstrip().startswith(("#", ";")):
                key = line.rstrip("\r\n").split("=", 1)[0].strip()
                if key in values:
                    output.append(f"{key}={values[key]}\n")
                    found.add(key)
                    continue
            output.append(line)
        output.extend(f"{key}={value}\n" for key, value in values.items() if key not in found)
        fd, temporary = tempfile.mkstemp(prefix=".server.properties.", dir=properties.parent, text=True)
        temporary_path = Path(temporary)
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as stream:
                stream.writelines(output)
                stream.flush()
                os.fsync(stream.fileno())
            os.chmod(temporary_path, stat.S_IMODE(info.st_mode) & 0o777)
            os.replace(temporary_path, properties)
        finally:
            temporary_path.unlink(missing_ok=True)
        return 0
    except (OSError, UnicodeError, ValueError):
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
