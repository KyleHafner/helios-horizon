#!/usr/bin/env python3
"""Fixed compatibility front door for the package Sunlit manifest policy."""

from __future__ import annotations

import sys
from pathlib import Path


_PACKAGE_SRC = Path("/opt/game-control/src")
if not (_PACKAGE_SRC / "game_control").is_dir():
    _PACKAGE_SRC = Path(__file__).resolve().parents[2] / "src"
if str(_PACKAGE_SRC) not in sys.path:
    sys.path.insert(0, str(_PACKAGE_SRC))

from game_control.sunlit_manifest import *  # noqa: F401,F403,E402
from game_control.sunlit_manifest import main


if __name__ == "__main__":
    raise SystemExit(main())
