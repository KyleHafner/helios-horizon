[Unit]
Description=Terraria tModLoader game server
After=network-online.target
Wants=network-online.target
OnFailure=horizon-alert-notify@terraria-tmod.service
AssertPathIsDirectory=/srv/game-servers/terraria-tmod/logs/tModLoader-Logs
AssertPathIsDirectory=/opt/game-servers/terraria-tmod/current/tModLoader-Logs

[Service]
Type=simple
User=tmodloader
Group=tmodloader
WorkingDirectory=/srv/game-servers/terraria-tmod
Environment=GAME_SLOT_REQUIRE_RESERVATION=1
ExecStart=/usr/local/libexec/game-slot-run terraria-tmod
ExecStop=/usr/local/libexec/game-console-stop terraria-tmod $MAINPID
KillSignal=SIGINT
TimeoutStopSec=90
Restart=no
Slice=games.slice
CPUAccounting=yes
MemoryAccounting=yes
IOAccounting=yes
MemorySwapMax=0
StandardOutput=journal
StandardError=journal
LogNamespace=horizon
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
BindPaths=/srv/game-servers/terraria-tmod/logs/tModLoader-Logs:/opt/game-servers/terraria-tmod/current/tModLoader-Logs
ReadOnlyPaths=/opt/game-control /etc/game-control /usr/local/libexec /usr/bin /opt/game-servers/terraria-tmod
ReadWritePaths=/run/game-control /run/game-slot /srv/game-servers/terraria-tmod
UMask=0077
